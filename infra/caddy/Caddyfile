:80 {
  encode gzip zstd

  @static path /static/*
  handle @static {
    root * /srv
    file_server
  }

  @media path /media/*
  handle @media {
    root * /srv
    file_server
  }

  # Preview (proxy a web-preview:8001, quitando el prefijo /preview)
  handle_path /preview/* {
    reverse_proxy web-preview:8001
  }

  # Producción por defecto
  reverse_proxy web:8000
}
