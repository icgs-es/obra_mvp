{
    auto_https off
}

portal.finaninvestgroup.com:80 {
    encode gzip
    reverse_proxy nextcloud:80 {
        header_up X-Forwarded-Proto https
        header_up Host {host}
    }
}

finaninvestgroup.com:80 {
    encode gzip

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto https
            header_up Host {host}
        }
    }
}

competa.finaninvestgroup.com:80 {
    encode gzip
    reverse_proxy http://172.17.0.1:8010 {
        header_up X-Forwarded-Proto https
        header_up Host {host}
    }
}

farmasani.finaninvestgroup.com:80 {
    encode gzip
    reverse_proxy farmasani_dolibarr:80 {
        header_up X-Forwarded-Proto https
        header_up Host {host}
    }
}
