# ─────────────────────────────────────────────────────────────
# FinanInvest Group - Caddyfile (prod)
# Sirve /static y /media desde Caddy; TODO lo demás → Django
# ─────────────────────────────────────────────────────────────

finaninvestgroup.com {
    encode gzip

    # --- estáticos ---
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # --- preview protegido (mantén tu hash real) ---
    # basic_auth /preview/* {
    #     icgs $2a$14$........TU_HASH........
    # }
    handle_path /preview/* {
        reverse_proxy web-preview:8001
    }

    # --- n8n (si lo tienes levantado) ---
    handle_path /n8n/* {
        reverse_proxy n8n:5678
    }

    # --- CATCH-ALL → Django ---
    # IMPORTANTÍSIMO: sin file_server por defecto; 
    # cualquier ruta no capturada arriba (incluida "/") va a Django.
    handle {
        reverse_proxy web:8000
    }

    # Sirve /manual/* desde /srv/site (que es /opt/www en el host)
    #handle /manual* {
    #    root * /srv/site
    #    file_server
    #}
}


